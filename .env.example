# ============================================================
# .env.example — Copy this file to .env and fill in your keys
# ============================================================

# ----------------------------------------------------------
# EURI API (required for main.py RAG chatbot)
# Get your key at https://euron.one
# ----------------------------------------------------------
EURI_API_KEY=your_euri_api_key_here

# ----------------------------------------------------------
# Optional: override the default knowledge-base document path
# Default: <repo_root>/data/google.txt
# ----------------------------------------------------------
# DATA_FILE=/absolute/path/to/your/document.txt

# ----------------------------------------------------------
# OpenAI (required for Models/LLMS and Models/chatmodels notebooks)
# ----------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------
# Google Gemini (required for Models/chatmodels and Models/Chains notebooks)
# ----------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# ----------------------------------------------------------
# Anthropic Claude (required for Models/chatmodels notebook)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------------------------
# HuggingFace (required for Models/chatmodels and Models/Embeddingmodels notebooks)
# ----------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
